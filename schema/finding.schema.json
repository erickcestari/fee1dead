{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Finding",
  "description": "A validated vulnerability finding emitted by the harness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "attack_class",
    "severity",
    "location",
    "description",
    "impact",
    "recommendation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable unique identifier for the finding."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "attack_class": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": ["info", "low", "medium", "high", "critical"]
    },
    "location": {
      "type": "string",
      "description": "Code location in path:line form.",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "description": "The target commit `location` refers to, set by the harness.",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "attack_scenario": {
      "type": "string",
      "description": "How an attacker exploits it: actors, steps, preconditions, and cost.",
      "minLength": 1
    },
    "impact": {
      "type": "string",
      "description": "What an attacker gains; concrete consequence.",
      "minLength": 1
    },
    "recommendation": {
      "type": "string",
      "description": "How to fix or mitigate.",
      "minLength": 1
    },
    "poc_path": {
      "type": "string",
      "description": "Proof-of-concept path relative to the run's out dir, set by the harness."
    },
    "evidence": {
      "type": "string",
      "description": "Validator evidence supporting the finding."
    },
    "verdict": {
      "type": "string",
      "enum": ["confirmed", "downgraded", "needs_review"],
      "description": "Review verdict, set by the harness. needs_review means unverified: a human must confirm it."
    }
  }
}
